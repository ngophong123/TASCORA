# Placeholder names only. Configure privately in a staging secret manager, never in the existing .env.
# Explicit no-provider staging: APP_ENV=staging, NODE_ENV=production, PAYMENTS_PROVIDER=disabled.
# Default/stripe mode still requires Stripe TEST credentials in staging. Never disable production payments.
# Disabled mode needs no Stripe secret/webhook/public key; leave those variables unset.
PAYMENTS_PROVIDER=
APP_ENV=
NODE_ENV=
PORT=
DATABASE_URL=
REDIS_URL=
JWT_ACCESS_SECRET=
WEB_URL=
CORS_ORIGINS=
# Optional verified Vercel Preview origins; Render API only, never NEXT_PUBLIC_*.
# Requires APP_ENV=staging + NODE_ENV=production. Exact canonical origins remain above.
VERCEL_PREVIEW_CORS_ENABLED=false
VERCEL_PREVIEW_TEAM_ID=
VERCEL_PREVIEW_PROJECT_ID=
VERCEL_PREVIEW_GITHUB_REPO_ID=
# Comma-separated trusted branch names, not deployment URLs or wildcard patterns.
VERCEL_PREVIEW_GIT_REFS=
VERCEL_PREVIEW_API_TOKEN=
COOKIE_SAME_SITE=
# Render staging: trust one reverse-proxy hop; parsed as number 1, not a subnet string.
TRUST_PROXY=1
ENABLE_CRON=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WEB_URL=
STORAGE_PROVIDER=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=
STORAGE_FORCE_PATH_STYLE=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
PLATFORM_FEE_PERCENT=
ORDER_AUTO_COMPLETE_HOURS=
