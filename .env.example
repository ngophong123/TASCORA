# Template only. Supply private values through your hosting secret manager.
# DATABASE
DATABASE_URL=
# AUTH: strong random access secret; refresh tokens are opaque (no refresh JWT secret).
JWT_ACCESS_SECRET=
# lax for same-site domains; none for separate HTTPS sites (browser restrictions apply).
COOKIE_SAME_SITE=
# FRONTEND: public build-time API origin, without /api/v1.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WEB_URL=
# BACKEND: production must use exact HTTPS origins; comma-separated additional origins.
NODE_ENV=
APP_ENV=
PORT=
WEB_URL=
CORS_ORIGINS=
# Trusted proxy IP/CIDR list. Set only to match the hosting proxy topology.
TRUST_PROXY=
# Enable on exactly one API replica; production schedules are hourly/daily.
ENABLE_CRON=
# REDIS: native Redis protocol; use rediss:// for managed TLS endpoints.
REDIS_URL=
# EMAIL: required for production; Ethereal fallback only in development.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# PAYMENTS: configure server-side Stripe key and webhook signing secret.
PAYMENTS_PROVIDER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# FIXTURE GENERATOR: optional development-only; never a production DB seed.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# STORAGE: production requires s3; development defaults to local when unset.
STORAGE_PROVIDER=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_FORCE_PATH_STYLE=
STORAGE_LOCAL_PATH=
PLATFORM_FEE_PERCENT=
ORDER_AUTO_COMPLETE_HOURS=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
