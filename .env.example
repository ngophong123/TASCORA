# Template only. Supply private values through your hosting secret manager.
# DATABASE
DATABASE_URL=
# AUTH: strong random access secret; refresh tokens are opaque (no refresh JWT secret).
JWT_ACCESS_SECRET=
# KYC PII ENCRYPTION: 64-hex (32-byte) or high-entropy >=32-char secret; mandatory in production/staging.
KYC_ENCRYPTION_KEY=
# Active key ID stamped on v2 ciphertexts (default k1) and comma-separated old keyId=secret pairs during rotation.
KYC_ENCRYPTION_KEY_ID=
KYC_ENCRYPTION_PREVIOUS_KEYS=
# KYC DOCUMENT BLIND-INDEX HMAC: dedicated strong secret distinct from KYC_ENCRYPTION_KEY (mandatory in prod/staging).
KYC_DOCUMENT_HMAC_KEY=
KYC_DOCUMENT_HMAC_KEY_ID=
KYC_DOCUMENT_HMAC_PREVIOUS_KEYS=
# Set to true only after running workers/kyc-hmac-migrate --verify-only to retire legacy v1 HMAC fallback lookup.
KYC_DISABLE_LEGACY_HMAC=
# KYC MALWARE SCANNER & WORKER: fail-closed QUARANTINED unless clamd is explicitly configured and reports CLEAN.
KYC_SCANNER_PROVIDER=
CLAMD_HOST=
CLAMD_PORT=
CLAMD_TIMEOUT_MS=
CLAMD_MAX_CONCURRENT=
KYC_SCAN_INTERVAL_MS=
KYC_SCAN_BATCH_SIZE=
KYC_SCAN_MAX_ATTEMPTS=
KYC_SCAN_LEASE_MS=
# lax for same-site domains; none for separate HTTPS sites (browser restrictions apply).
COOKIE_SAME_SITE=
# FRONTEND: public build-time API origin, without /api/v1.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WEB_URL=
# BACKEND: production must use exact HTTPS origins; comma-separated additional origins.
NODE_ENV=
APP_ENV=
PORT=
WEB_URL=
CORS_ORIGINS=
# Staging-only, optional Vercel-verified Preview CORS. See docs/CORS_PERMANENT_FIX_AUDIT.md.
# Private API-side values only; disabled for production and local development.
VERCEL_PREVIEW_CORS_ENABLED=false
VERCEL_PREVIEW_TEAM_ID=
VERCEL_PREVIEW_PROJECT_ID=
VERCEL_PREVIEW_GITHUB_REPO_ID=
VERCEL_PREVIEW_GIT_REFS=
VERCEL_PREVIEW_API_TOKEN=
# Boolean or non-negative integer proxy hop count; missing/blank defaults false.
# Render staging uses TRUST_PROXY=1. Match the ingress topology; do not use true as a workaround.
TRUST_PROXY=
# Enable on exactly one API replica; production schedules are hourly/daily.
ENABLE_CRON=
# REDIS: native Redis protocol; use rediss:// for managed TLS endpoints.
REDIS_URL=
# SOCKET.IO REDIS ADAPTER: false keeps the default in-memory adapter; true enables @socket.io/redis-adapter
# Pub/Sub across API replicas (requires reachable REDIS_URL shared by all replicas; does not by itself prove
# full multi-instance hosted readiness).
ENABLE_SOCKET_REDIS_ADAPTER=false
# EMAIL: required for production; Ethereal fallback only in development.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# PAYMENTS: configure server-side Stripe key and webhook signing secret.
PAYMENTS_PROVIDER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# FIXTURE GENERATOR: optional development-only; never a production DB seed.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# STORAGE: production requires s3; development defaults to local when unset.
STORAGE_PROVIDER=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_FORCE_PATH_STYLE=
STORAGE_LOCAL_PATH=
PLATFORM_FEE_PERCENT=
ORDER_AUTO_COMPLETE_HOURS=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
