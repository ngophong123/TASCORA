{
  "extends": "./packages/tsconfig/node.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "resolveJsonModule": true,
    "module": "CommonJS",
    "moduleResolution": "node",
    "baseUrl": ".",
    "types": ["node"],
    "typeRoots": ["./node_modules/@types", "./apps/web/node_modules/@types"],
    "paths": {
      "@/*": ["./apps/web/src/*"],
      "stripe": ["./apps/api/node_modules/stripe"],
      "express": ["./apps/api/node_modules/@types/express"],
      "express/*": ["./apps/api/node_modules/express/*"],
      "cors": ["./apps/api/node_modules/@types/cors"],
      "ioredis": ["./apps/api/node_modules/ioredis"],
      "zod": ["./apps/api/node_modules/zod"],
      "bcryptjs": ["./apps/api/node_modules/@types/bcryptjs"],
      "jsonwebtoken": ["./apps/api/node_modules/@types/jsonwebtoken"],
      "nodemailer": ["./apps/api/node_modules/@types/nodemailer"],
      "socket.io": ["./apps/api/node_modules/socket.io"],
      "@aws-sdk/*": ["./apps/api/node_modules/@aws-sdk/*"],
      "@prisma/client": ["./apps/api/node_modules/@prisma/client"]
    }
  },
  "include": [
    "tests/database/disposable-postgres.spec.ts",
    "tests/security/admin-audit-integrity.spec.ts",
    "tests/security/clamd-scanner-hardening.spec.ts",
    "tests/security/kyc-cross-key-uniqueness.spec.ts",
    "tests/security/kyc-hmac-migration.spec.ts",
    "tests/security/kyc-security.spec.ts",
    "tests/security/marketplace-image-policy.spec.ts",
    "tests/security/message-persistence.spec.ts",
    "tests/security/order-payment.spec.ts",
    "tests/security/preview-origin-policy.spec.ts",
    "tests/security/production-config.spec.ts",
    "tests/security/security-headers.spec.ts",
    "tests/security/upload-chat-isolation.spec.ts",
    "tests/security/validated-input.spec.ts",
    "tests/api/api-contracts.spec.ts",
    "tests/api/kyc-scan-worker.spec.ts",
    "tests/api/password-recovery.spec.ts",
    "tests/api/payment-provider-disabled.spec.ts",
    "tests/api/seller-kyc.spec.ts",
    "tests/api/trust-proxy.spec.ts",
    "tests/api/upload-security.spec.ts",
    "tests/unit/auth-validation.spec.ts",
    "tests/unit/catalog-data.spec.ts",
    "tests/unit/catalog-filter.spec.ts",
    "tests/unit/catalog-surgical-fixes.spec.ts",
    "tests/unit/kyc-hmac-migrate-cli.spec.ts",
    "tests/unit/kyc-validation.spec.ts",
    "tests/unit/order-lifecycle.spec.ts",
    "tests/unit/pricing.spec.ts",
    "tests/unit/trust-proxy.spec.ts",
    "tests/unit/upload-references-storage.spec.ts",
    "tests/unit/wallet-ledger.spec.ts"
  ]
}
